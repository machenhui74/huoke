diff --git a/b/tests/test_douyin_search_truncate.py b/tests/test_douyin_search_truncate.py
new file mode 100644
index 0000000..0ec1113
--- /dev/null
+++ b/tests/test_douyin_search_truncate.py
@@ -0,0 +1,58 @@
+# -*- coding: utf-8 -*-
+"""静态验收：抖音搜索页截断保证处理条数 ≤ CRAWLER_MAX_NOTES_COUNT。
+
+不联网、不启动真实采数。配置为 5 时不得被页大小 10 抬高。
+"""
+
+import inspect
+
+from media_platform.douyin.core import DouYinCrawler
+from media_platform.douyin.help import truncate_search_aweme_items
+
+
+def _make_items(n: int, extra_invalid: bool = True):
+    items = [{"aweme_info": {"aweme_id": f"a{i}", "desc": f"t{i}"}} for i in range(n)]
+    if extra_invalid:
+        items.insert(0, {"aweme_mix_info": {}})
+        items.append({"not_a_video": True})
+    return items
+
+
+def test_truncate_first_page_to_max_five():
+    items = _make_items(10)
+    out = truncate_search_aweme_items(items, max_notes_count=5, crawled_count=0)
+    assert len(out) == 5
+    assert [i["aweme_id"] for i in out] == ["a0", "a1", "a2", "a3", "a4"]
+
+
+def test_truncate_remaining_on_second_page():
+    items = _make_items(10, extra_invalid=False)
+    out = truncate_search_aweme_items(items, max_notes_count=12, crawled_count=10)
+    assert len(out) == 2
+    assert out[0]["aweme_id"] == "a0"
+
+
+def test_truncate_when_already_at_limit():
+    items = _make_items(10)
+    out = truncate_search_aweme_items(items, max_notes_count=5, crawled_count=5)
+    assert out == []
+
+
+def test_truncate_keeps_mix_first_item():
+    items = [
+        {"aweme_mix_info": {"mix_items": [{"aweme_id": "mix0"}]}},
+        {"aweme_info": {"aweme_id": "plain1"}},
+    ]
+    out = truncate_search_aweme_items(items, max_notes_count=5, crawled_count=0)
+    assert [i["aweme_id"] for i in out] == ["mix0", "plain1"]
+
+
+def test_search_keeps_configured_max_of_five():
+    src = inspect.getsource(DouYinCrawler.search)
+    assert "config.CRAWLER_MAX_NOTES_COUNT = dy_limit_count" not in src
+    assert "config.CRAWLER_MAX_NOTES_COUNT =" not in src
+    assert "max_notes_count = config.CRAWLER_MAX_NOTES_COUNT" in src
+    assert "truncate_search_aweme_items" in src
+    assert "while crawled_aweme_count < max_notes_count" in src
+    # 页大小仍是接口固定值，但不再当作条数下限
+    assert "dy_limit_count = 10" in src
