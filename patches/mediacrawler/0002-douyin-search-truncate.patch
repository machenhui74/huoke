+def truncate_search_aweme_items(
+    items: List[Dict],
+    max_notes_count: int,
+    crawled_count: int = 0,
+) -> List[Dict]:
+    """防封号：搜索页截断 — 进入存储/评论前将作品列表截到剩余配额。
+
+    抽出 aweme_info（或合集首条）后按剩余额度切片，保证处理条数 ≤ CRAWLER_MAX_NOTES_COUNT。
+    """
+    remaining = max(0, int(max_notes_count) - int(crawled_count))
+    extracted: List[Dict] = []
+    for post_item in items or []:
+        if not isinstance(post_item, dict):
+            continue
+        try:
+            aweme_info = post_item.get("aweme_info") or post_item.get("aweme_mix_info", {}).get("mix_items")[0]
+        except (TypeError, AttributeError, KeyError, IndexError):
+            continue
+        if isinstance(aweme_info, dict):
+            extracted.append(aweme_info)
+    return extracted[:remaining]
+
+
