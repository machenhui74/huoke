+
+def truncate_search_note_items(
+    items: List[Dict],
+    max_notes_count: int,
+    crawled_count: int = 0,
+) -> List[Dict]:
+    """防封号：搜索页截断 — 进入详情/评论前将笔记列表截到剩余配额。
+
+    过滤推荐词等非笔记项后，按剩余额度切片，保证详情请求数 ≤ CRAWLER_MAX_NOTES_COUNT。
+    """
+    remaining = max(0, int(max_notes_count) - int(crawled_count))
+    filtered = [
+        item
+        for item in (items or [])
+        if isinstance(item, dict) and item.get("model_type") not in ("rec_query", "hot_query")
+    ]
+    return filtered[:remaining]
+
+
