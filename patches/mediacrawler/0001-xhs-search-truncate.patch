     t = int(random.uniform(0, 2147483646))
diff --git a/b/tests/test_xhs_search_truncate.py b/tests/test_xhs_search_truncate.py
new file mode 100644
index 0000000..e550a0a
--- /dev/null
+++ b/tests/test_xhs_search_truncate.py
@@ -0,0 +1,46 @@
+# -*- coding: utf-8 -*-
+"""静态验收：搜索页截断函数保证详情候选数 ≤ CRAWLER_MAX_NOTES_COUNT。
+
+不联网、不启动真实采数。
+"""
+
+from media_platform.xhs.help import truncate_search_note_items
+
+
+def _make_items(n: int, extra_query: bool = True):
+    items = [{"id": f"n{i}", "model_type": "note", "xsec_token": "t", "xsec_source": "pc_search"} for i in range(n)]
+    if extra_query:
+        items.insert(0, {"model_type": "rec_query", "id": "q1"})
+        items.append({"model_type": "hot_query", "id": "q2"})
+    return items
+
+
+def test_truncate_first_page_to_max_five():
+    items = _make_items(20)
+    out = truncate_search_note_items(items, max_notes_count=5, crawled_count=0)
+    assert len(out) == 5
+    assert all(i["model_type"] == "note" for i in out)
+    assert [i["id"] for i in out] == ["n0", "n1", "n2", "n3", "n4"]
+
+
+def test_truncate_remaining_on_second_page():
+    items = _make_items(20, extra_query=False)
+    out = truncate_search_note_items(items, max_notes_count=25, crawled_count=20)
+    assert len(out) == 5
+    assert out[0]["id"] == "n0"
+
+
+def test_truncate_when_already_at_limit():
+    items = _make_items(20)
+    out = truncate_search_note_items(items, max_notes_count=5, crawled_count=5)
+    assert out == []
+
+
+def test_truncate_filters_non_note_only():
+    items = [
+        {"id": "q", "model_type": "rec_query"},
+        {"id": "a", "model_type": "note"},
+        {"id": "b", "model_type": "note"},
+    ]
+    out = truncate_search_note_items(items, max_notes_count=10, crawled_count=0)
+    assert [i["id"] for i in out] == ["a", "b"]
